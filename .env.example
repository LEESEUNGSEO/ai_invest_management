# ==============================================================================
# AI Invest Management Environment Variables Template
# 이 파일을 복사하여 .env 파일을 생성하고 실제 키/값을 입력하세요.
# (주의: .env 파일 및 실제 토큰은 GitHub에 절대 커밋하지 마세요!)
# ==============================================================================

# 1. Google Cloud Platform (GCS 상태 동기화 및 Secret Manager)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_BUCKET_NAME=your-gcp-project-id-trading-state

# 2. Google Gemini API (시장 분석 및 Search Grounding 실시간 검색)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-4-argon,gemini-3.8-flash,gemini-3.7-flash

# 3. 한국투자증권(KIS) OpenAPI 설정
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_CANO=your-kis-account-8digits
KIS_PRDT_CD=01
KIS_IS_PAPER=false
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_VTS_URL=https://openapivts.koreainvestment.com:29443

# 4. 카카오톡 알림 설정
# 카카오 토큰은 파일(kakao_token.json)로 관리하거나 환경변수로 직접 주입할 수 있습니다.
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_TOKEN_FILE=kakao_token.json
KAKAO_ACCESS_TOKEN=your-kakao-access-token
KAKAO_REFRESH_TOKEN=your-kakao-refresh-token

# 5. 리스크 관리 설정 (선택 사항)
CASH_SAFETY_RATIO=0.90
MAX_TRADE_RATIO=0.20
MAX_PRICE_DEVIATION=0.03

# 6. 파일 경로 설정 (선택 사항)
# 로컬 개발 시에는 state_data/ 및 market_data/ 폴더의 json 파일이 사용됩니다.
STATE_DIR=state_data
STATE_FILE=state_data/strategy_state.json
MARKET_DATA_DIR=market_data
RESEARCH_PATH_PATTERN=market_data/us_market_data_*.json
MAX_RESEARCH_AGE_DAYS=1
MARKET_REPORT_PATH=latest_market_report.txt
